# ── Public site variables ─────────────────────────────────────────────────────
# Canonical URL. Update once the custom domain is active in Vercel.
NEXT_PUBLIC_SITE_URL=https://www.lumapremium.com

NEXT_PUBLIC_PORTFOLIO_URL=https://marcos-portfolio-premium.vercel.app
NEXT_PUBLIC_SITE_NAME=Luma Premium
NEXT_PUBLIC_SITE_DESCRIPTION=Arquitectura comercial digital para negocios premium

# WhatsApp number (digits only, with country code).
# If empty, falls back to the hardcoded default in src/lib/site.ts.
NEXT_PUBLIC_WHATSAPP_NUMBER=18492122647

# ── Google Sheets — Lead storage ─────────────────────────────────────────────
# The spreadsheet ID is found in the Google Sheets URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
LUMA_LEADS_SPREADSHEET_ID=

# Sheet tab names. Both tabs must exist before the first lead is written.
# Run: node scripts/create-luma-leads-v2-sheet.mjs  (once, with real ID)
LUMA_LEADS_SHEET_NAME=Luma Leads V1
LUMA_LEADS_SHEET_V2_NAME=Luma Leads V2

# ── GCP Workload Identity Federation — production auth ───────────────────────
#
# Authentication uses Vercel OIDC + GCP Workload Identity Federation.
# NO JSON keys or static service account credentials are used or needed.
#
# These values are fixed for the Luma Premium GCP project.
# Add them as plain-text environment variables in Vercel (not secrets).
#
GCP_PROJECT_ID=luma-premium-production
GCP_PROJECT_NUMBER=634208517438
GCP_SERVICE_ACCOUNT_EMAIL=luma-premium-web-leads@luma-premium-production.iam.gserviceaccount.com
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel-production
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel

# ── Removed — do not add back ─────────────────────────────────────────────────
# GOOGLE_CLIENT_EMAIL  — replaced by GCP Workload Identity Federation
# GOOGLE_PRIVATE_KEY   — replaced by GCP Workload Identity Federation

# ── CRM MVP — Phase 1 variables ──────────────────────────────────────────────
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
CRM_ADMIN_EMAILS=admin@example.com
CRM_SALES_EMAILS=sales@example.com
CRM_DATA_MODE=mock

