# Canonical URL del proyecto Luma Premium
# Actual: producción en Vercel. Cuando el dominio esté activo y apuntado:
# NEXT_PUBLIC_SITE_URL=https://lumapremium.com
NEXT_PUBLIC_SITE_URL=https://luma-premium.vercel.app

# URL del portfolio Marcos Hilario
NEXT_PUBLIC_PORTFOLIO_URL=https://marcos-portfolio-premium.vercel.app

# Nombre y descripción pública del sitio
NEXT_PUBLIC_SITE_NAME=Luma Premium
NEXT_PUBLIC_SITE_DESCRIPTION=Arquitectura comercial digital para negocios premium

# WhatsApp público (solo dígitos, con código de país). Si se deja vacío, el código
# usa el fallback público definido en src/lib/site.ts. Configurar en Vercel:
NEXT_PUBLIC_WHATSAPP_NUMBER=18492122647

# Google Sheets Integration - B2B Leads
LUMA_LEADS_SPREADSHEET_ID=
LUMA_LEADS_SHEET_NAME=Luma Estate Leads
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=